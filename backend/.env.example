# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=erp_user
DB_PASSWORD=erp_password
DB_DATABASE=erp_db

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed
SEED_ADMIN_EMAIL=admin@erp.local
SEED_ADMIN_PASSWORD=0145

# Backup
# Directory on the server's disk where encrypted backup files are stored.
BACKUP_STORAGE_DIR=./backups
# REQUIRED for backups to work — a 64-character hex string (32 bytes) used to AES-256-GCM
# encrypt every backup file at rest. Generate one with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
# Cron expression for the automatic scheduled backup (default: every day at 2:00 AM).
BACKUP_CRON_SCHEDULE=0 2 * * *
# Backup records (and their files) older than this many days are deleted automatically.
BACKUP_RETENTION_DAYS=30
# Only needed if pg_dump/pg_restore are not on the server's PATH.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
# Email address that receives backup success/failure alerts (in addition to the server log).
BACKUP_ADMIN_EMAIL=

# Backup — optional S3 upload (leave BACKUP_S3_BUCKET empty to store locally only)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Backup — optional SMTP alerts (leave SMTP_HOST empty to rely on the server log only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@erp.local
